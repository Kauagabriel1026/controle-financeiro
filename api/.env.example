APP_NAME="Kamel Controle Financeiro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

# Custo do bcrypt na conferência de senha: 10 é o mínimo recomendado pela OWASP
# e cabe na CPU da hospedagem gratuita (12 levava 1,4 s por login).
BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=controle_financeiro
DB_USERNAME=financeiro
DB_PASSWORD=financeiro

# O limite de tentativas de login é contado no banco de dados.
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=sync

# Endereço do front-end, usado no link de redefinição de senha.
FRONT_URL=http://localhost:5173

# Envio de e-mails pelo Brevo. Sem a chave, o link de redefinição de senha
# aparece em storage/logs/laravel.log em vez de ser enviado.
BREVO_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Kamel Controle Financeiro"
