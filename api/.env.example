APP_NAME="Kamel Controle Financeiro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=controle_financeiro
DB_USERNAME=financeiro
DB_PASSWORD=financeiro

# O limite de tentativas de login é contado no banco de dados.
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=sync
