# Imagem de produção da API: Apache + PHP, com o código e as dependências
# dentro da imagem. A de desenvolvimento é o Dockerfile ao lado.
FROM php:8.3-apache

RUN apt-get update \
    && apt-get install -y --no-install-recommends git unzip libpq-dev libzip-dev \
    && docker-php-ext-install pdo_pgsql zip opcache \
    && rm -rf /var/lib/apt/lists/* \
    && a2enmod rewrite \
    && mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# O Apache serve só a pasta public; o resto do código fica fora do alcance da web.
ENV APACHE_DOCUMENT_ROOT=/var/www/api/public
RUN sed -ri "s!/var/www/html!${APACHE_DOCUMENT_ROOT}!g" /etc/apache2/sites-available/*.conf \
    && echo "ServerName localhost" > /etc/apache2/conf-enabled/servidor.conf

COPY docker/php.prod.ini /usr/local/etc/php/conf.d/kamel.ini
COPY docker/apache.prod.conf /etc/apache2/conf-enabled/kamel.conf

WORKDIR /var/www/api

# As dependências são instaladas antes de copiar o código: enquanto o
# composer.json não mudar, o Docker reaproveita esta etapa.
COPY composer.json composer.lock* ./
RUN composer install --no-dev --no-interaction --prefer-dist --no-scripts --no-autoloader

COPY . .
RUN composer dump-autoload --no-dev --optimize \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod +x docker/entrypoint.prod.sh

# Valores de produção. Segredos (APP_KEY, DB_URL) e o endereço do front
# (CORS_ALLOWED_ORIGINS) vêm do painel da hospedagem, nunca da imagem.
ENV APP_NAME="Kamel Controle Financeiro" \
    APP_ENV=production \
    APP_DEBUG=false \
    APP_TIMEZONE=America/Sao_Paulo \
    APP_LOCALE=pt_BR \
    LOG_CHANNEL=stderr \
    LOG_LEVEL=warning \
    DB_CONNECTION=pgsql \
    CACHE_STORE=database \
    SESSION_DRIVER=array \
    QUEUE_CONNECTION=sync \
    BCRYPT_ROUNDS=10

EXPOSE 10000

ENTRYPOINT ["docker/entrypoint.prod.sh"]
CMD ["apache2-foreground"]
